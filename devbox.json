{
    "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
    "packages": [
        "clang@21.1.8",
        "cmake@3.31.6",
        "git@latest",
        "ffmpeg@latest",
        "libvmaf@3.0.0",
        "libvmaf@3.0.0"
    ],
    "shell": {
        "init_hook": [
            "echo 'Devbox NLM environment ready' > /dev/null"
        ],
        "scripts": {
            "build": [
                "cmake -B build -S . -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=$PWD/install",
                "cmake --build build"
            ],
            "test": [
                "devbox run build",
                "cd build && ctest --output-on-failure"
            ],
            "install": [
                "devbox run build",
                "cmake --install build",
                "echo 'Installed to install/bin/denoise + install/bin/v-denoise'"
            ],
            "clean": [
                "rm -rf build install"
            ]
        }
    }
}